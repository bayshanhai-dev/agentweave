    classDef runtime fill:#f59e0b,stroke:#b45309,color:#111,stroke-width:1.5px,rx:6,ry:6
    class Human human
    class Dashboard dashboard
    class API,Orchestrator,Gate,Projection control
    class DB,NATS durable
