NODE_ENV=development
CONTROL_API_PORT=3000
DATABASE_URL=postgresql://agentweave:agentweave@postgres:5432/agentweave
NATS_URL=nats://nats:4222
VITE_CONTROL_API_URL=http://localhost:3000
VITE_CONTROL_WS_URL=ws://localhost:3000/events
WORKER_ID=worker-local-1
WORKER_ROLES=pm,pe,coder,qa
WORKSPACE_ROOT=/workspaces
# The only host directory mounted into the Worker. Keep this narrow; do not
# point it at your home directory. Relative paths are resolved from the repo.
AGENTWEAVE_HOST_WORKSPACE=./workspaces
AGENTWEAVE_PROVIDER=mock
AGENTWEAVE_MODEL=
CODEX_BRIDGE_MODE=app-server
# Required only with AGENTWEAVE_PROVIDER=codex. This is resolved on the host
# where the bridge runs, and must correspond to AGENTWEAVE_HOST_WORKSPACE.
CODEX_HOST_WORKSPACE_ROOT=./workspaces
CODEX_CONTAINER_WORKSPACE_ROOT=/workspaces
CODEX_APP_SERVER_URL=http://host.docker.internal:3010
# Generate a unique local value before exposing a bridge beyond localhost.
CODEX_BRIDGE_TOKEN=
PROVIDER_REQUEST_TIMEOUT_MS=120000
