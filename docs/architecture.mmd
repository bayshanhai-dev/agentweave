flowchart LR
    Human["👤 Human Operator"]
    Dashboard["🖥️ React Dashboard<br/><small>Workstreams · Tasks · Hive · Activity · Controls · Summary</small>"]

    subgraph Control["⚙️ Control Plane"]
        API["Control API<br/><small>HTTP / WebSocket</small>"]
        Orch["Orchestrator<br/><small>routing · state transitions · retries · recovery</small>"]
        Policy["Policy & Approval<br/><small>authority · budgets · human decisions</small>"]
        Projector["Read Model / Event Projector"]
    end
    subgraph Durable["🗄️ Durable Backbone"]
        DB[("PostgreSQL<br/><small>workstreams · tasks · agents · sessions · inbox · evidence</small>")]
        NATS[("NATS JetStream<br/><small>events · commands · inboxes · ACK · retry · DLQ</small>")]
    end
    subgraph Runtime["⚡ Execution Plane — one or more Worker processes"]
        Worker["Worker Runtime Pool<br/><small>registration · heartbeat · task lease · consumer</small>"]
        Actors["Agent Runtime Actors<br/><small>PM · PE · Coder(s) · QA · Human-facing sessions</small>"]
        Session["Durable Session Manager<br/><small>provider session · checkpoint · lease · resume</small>"]
        Adapter["Provider Adapter Registry<br/><small>Mock · Codex · Claude · local / future tools</small>"]
        Workspace["Workspace Boundary & Evidence<br/><small>mounted project · git diff · tests · artifacts</small>"]
        Worker --> Actors --> Session --> Adapter --> Workspace
    end
    subgraph Hive["🐝 Agent Hive / Weave — any-direction collaboration"]
        HiveHuman["Human"]
        PM["PM<br/><small>lead</small>"]
        PE["PE<br/><small>reviewer / lead</small>"]
        Coder1["Coder-1<br/><small>executor</small>"]
        Coder2["Coder-2<br/><small>executor</small>"]
        QA["QA<br/><small>reviewer</small>"]
        HiveHuman <--> PM
        HiveHuman <--> PE
        HiveHuman <--> Coder1
        HiveHuman <--> Coder2
        HiveHuman <--> QA
        PM <--> PE
        PM <--> Coder1
        PM <--> Coder2
        PM <--> QA
        PE <--> Coder1
        PE <--> Coder2
        PE <--> QA
        Coder1 <--> Coder2
        Coder1 <--> QA
        Coder2 <--> QA
    end
    subgraph Scaling["📈 Human-Approved Scaling"]
        Detect["Detect parallel work"]
        Recommend["Scaling recommendation"]
        Approve["Human approval"]
        Add["Add Agent Actor / Session"]
    end

    Human <--> Dashboard
    Dashboard <-->|"HTTP / WebSocket"| API
    API --> Orch
    API --> Policy
    API <--> DB
    Orch <--> DB
    Orch <--> NATS
    Policy <--> DB
    NATS --> Projector --> DB
    NATS <--> Worker
    Actors <--> Hive
    Orch --> Detect --> Recommend --> Dashboard
    Dashboard --> Approve --> Add
    Add --> DB
    Add --> NATS

